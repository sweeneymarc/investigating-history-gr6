// QUIZ
function renderQuiz() {
  quizIndex = 0;
  quizScore = 0;
  quizAnswered = false;
  renderQuizHistory();
  showQuestion();
}

function showQuestion() {
  const u = currentUnit;
  const q = u.quiz[quizIndex];
  document.getElementById('quiz-area').innerHTML = `
    <div class="quiz-question-card">
      <div class="quiz-q-num">Question ${quizIndex + 1} of ${u.quiz.length}</div>
      <h4>${q.q}</h4>
      <div class="quiz-options">
        ${q.opts.map((opt, i) => `
          <button class="quiz-option" onclick="answerQuiz(${i})" id="opt-${i}">
            <span class="option-letter">${String.fromCharCode(65+i)}</span>
            ${opt}
          </button>
        `).join('')}
      </div>
      <div class="quiz-feedback" id="quiz-feedback"></div>
    </div>
    <div class="quiz-nav">
      <span class="quiz-progress">Score: ${quizScore}/${quizIndex}</span>
      <button class="btn btn-outline" id="next-btn" onclick="nextQuestion()" style="display:none">Next Question →</button>
    </div>
  `;
  quizAnswered = false;
}

function answerQuiz(i) {
  if (quizAnswered) return;
  quizAnswered = true;
  const q = currentUnit.quiz[quizIndex];
  const opts = document.querySelectorAll('.quiz-option');
  const fb = document.getElementById('quiz-feedback');
  opts.forEach(o => o.classList.add('answered'));
  if (i === q.correct) {
    quizScore++;
    opts[i].classList.add('correct');
    fb.textContent = '✓ ' + q.feedback;
    fb.className = 'quiz-feedback show correct';
  } else {
    opts[i].classList.add('incorrect');
    opts[q.correct].classList.add('correct');
    fb.textContent = '✗ ' + q.feedback;
    fb.className = 'quiz-feedback show incorrect';
  }
  document.querySelector('.quiz-progress').textContent = `Score: ${quizScore}/${quizIndex + 1}`;
  if (quizIndex < currentUnit.quiz.length - 1) {
    document.getElementById('next-btn').style.display = 'flex';
  } else {
    setTimeout(showScore, 1400);
  }
}

function nextQuestion() { quizIndex++; showQuestion(); }

function showScore() {
  const pct = Math.round((quizScore / currentUnit.quiz.length) * 100);
  const msg = pct >= 90 ? 'Outstanding! 🏆' : pct >= 70 ? 'Great work! 🌟' : pct >= 50 ? 'Good effort! Keep reviewing.' : 'Keep studying — you\'ve got this!';
  saveQuizResult(quizScore, currentUnit.quiz.length);
  renderQuizHistory();
  document.getElementById('quiz-area').innerHTML = `
    <div class="quiz-score">
      <h3>${quizScore} / ${currentUnit.quiz.length}</h3>
      <p style="font-size:28px;margin-bottom:12px;">${pct}%</p>
      <p>${msg}</p>
      <button class="btn btn-gold" onclick="renderQuiz()" style="margin:0 auto;display:flex;">Try Again</button>
    </div>
  `;
}

