const ACH_KEY = 'ih_achievements';
const QUIZ_KEY = 'ih_quiz_scores';
const NOTE_KEY = 'ih_notes';

function loadAchievements() { try { return JSON.parse(localStorage.getItem(ACH_KEY)) || {}; } catch { return {}; } }
function saveAchievements(d) { try { localStorage.setItem(ACH_KEY, JSON.stringify(d)); } catch {} }
function loadQuizScores() { try { return JSON.parse(localStorage.getItem(QUIZ_KEY)) || {}; } catch { return {}; } }
function saveQuizScores(d) { try { localStorage.setItem(QUIZ_KEY, JSON.stringify(d)); } catch {} }
function loadNotes() { try { return JSON.parse(localStorage.getItem(NOTE_KEY)) || {}; } catch { return {}; } }
function saveNotes(d) { try { localStorage.setItem(NOTE_KEY, JSON.stringify(d)); } catch {} }

let achievements = loadAchievements();
let quizScores = loadQuizScores();
let notes = loadNotes();
let unitActivity = {};

function getUnitKey() { return currentUnit ? `u${currentUnit.id}` : null; }

function trackActivity(key, value) {
  const uk = getUnitKey();
  if (!uk) return;
  if (!unitActivity[uk]) unitActivity[uk] = {};
  unitActivity[uk][key] = value;
  checkAchievements();
}

function checkAchievements() {
  const uk = getUnitKey();
  if (!uk) return;
  const data = unitActivity[uk] || {};
  let newUnlock = false;
  ACHIEVEMENTS.forEach(a => {
    const achKey = uk + '_' + a.id;
    if (!achievements[achKey] && a.check(currentUnit, data)) {
      achievements[achKey] = true;
      saveAchievements(achievements);
      newUnlock = true;
      const el = document.getElementById('ach-' + achKey);
      if (el) { el.classList.remove('locked'); el.classList.add('unlocked', 'just-unlocked'); }
    }
  });
}

function renderAchievements() {
  const uk = getUnitKey();
  const bar = document.getElementById('achievements-bar');
  if (!bar || !uk) return;
  bar.innerHTML = '<span style="font-family:Cinzel,serif;font-size:9px;letter-spacing:0.15em;color:rgba(200,151,58,0.5);text-transform:uppercase;margin-right:4px;">Achievements:</span>' +
    ACHIEVEMENTS.map(a => {
      const achKey = uk + '_' + a.id;
      const unlocked = achievements[achKey];
      return `<div class="ach-badge ${unlocked ? 'unlocked' : 'locked'}" id="ach-${achKey}" title="${a.how}">${a.icon} ${a.label}</div>`;
    }).join('');
}

