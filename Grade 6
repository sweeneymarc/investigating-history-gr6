function updateLessonSelect() { updateGeneratedLink(); }

function updateGeneratedLink() {
  const unit = document.getElementById('tl-unit')?.value;
  const mod = document.getElementById('tl-module')?.value;
  const base = window.location.href.split('?')[0];
  const el = document.getElementById('generated-link');
  if (!el) return;
  if (!unit && unit !== '0') {
    el.textContent = 'Select a unit above to generate a link...';
    return;
  }
  el.textContent = `${base}?unit=${unit}&module=${mod}`;
}

function copyLink() {
  const text = document.getElementById('generated-link').textContent;
  if (text.includes('Select')) return;
  copyText(text, document.querySelector('.copy-link-btn'));
}

function copyText(text, btn) {
  navigator.clipboard.writeText(text).then(() => {
    const orig = btn.textContent;
    btn.textContent = '✓ Copied!';
    setTimeout(() => btn.textContent = orig, 2000);
  });
}

// ============================================================
//  URL PARAMETER HANDLING (Today's Lesson)
// ============================================================
function handleURLParams() {
  const params = new URLSearchParams(window.location.search);
  const unit = params.get('unit');
  const mod = params.get('module');
  if (unit !== null && UNITS[parseInt(unit)]) {
    openUnit(parseInt(unit));
    if (mod) setTimeout(() => showModule(mod), 100);
    // Show today's lesson banner on home isn't needed — we go straight to the unit
    return true;
  }
  return false;
}

// ============================================================
//  INIT
// ============================================================
document.addEventListener('DOMContentLoaded', () => {
  // Handle URL parameters first (Today's Lesson feature)
  const deepLinked = handleURLParams();

  // Stagger unit card animations if on home screen
  if (!deepLinked) {
    document.querySelectorAll('.unit-card').forEach((c, i) => {
      c.style.animationDelay = `${i * 0.08}s`;
      c.style.animation = `fadeIn 0.5s ease ${i * 0.08}s both`;
    });
  }

  // Listen for select changes in teacher dashboard
  document.getElementById('tl-unit')?.addEventListener('change', updateGeneratedLink);
  document.getElementById('tl-module')?.addEventListener('change', updateGeneratedLink);
});
