<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Investigating History — Grade 6</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Source+Serif+4:ital,wght@0,300;0,400;0,600;1,300&family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --navy: #0d1b2a;
    --navy-mid: #1a2f46;
    --navy-light: #243b55;
    --gold: #c8973a;
    --gold-light: #e8b85a;
    --gold-pale: #f5e6c8;
    --cream: #f9f4ec;
    --parchment: #f0e6d0;
    --text-dark: #1a1208;
    --text-mid: #3d2f1c;
    --text-light: #f9f4ec;
    --accent-red: #8b2b2b;
    --accent-green: #2b5c3a;
    --accent-teal: #1d4e5a;
    --shadow: 0 8px 32px rgba(13,27,42,0.25);
    --shadow-gold: 0 4px 20px rgba(200,151,58,0.3);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Source Serif 4', serif;
    background: var(--navy);
    color: var(--text-light);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* ===== SCREENS ===== */
  .screen { display: none; min-height: 100vh; }
  .screen.active { display: block; }

  /* ===== HOME SCREEN ===== */
  #home {
    background: var(--navy);
    position: relative;
    overflow: hidden;
  }

  .home-bg {
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 20%, rgba(200,151,58,0.08) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 80%, rgba(29,78,90,0.15) 0%, transparent 50%),
      linear-gradient(160deg, #0d1b2a 0%, #1a2f46 50%, #0d1b2a 100%);
    z-index: 0;
  }

  .home-pattern {
    position: fixed;
    inset: 0;
    opacity: 0.04;
    background-image:
      repeating-linear-gradient(45deg, var(--gold) 0, var(--gold) 1px, transparent 0, transparent 50%),
      repeating-linear-gradient(-45deg, var(--gold) 0, var(--gold) 1px, transparent 0, transparent 50%);
    background-size: 30px 30px;
    z-index: 0;
  }

  .home-content {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px 60px;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 0 0;
    border-bottom: 1px solid rgba(200,151,58,0.2);
    margin-bottom: 60px;
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .logo-emblem {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, var(--gold), var(--gold-light));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    box-shadow: var(--shadow-gold);
    flex-shrink: 0;
  }

  .logo-text {
    font-family: 'Cinzel', serif;
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--gold-pale);
    line-height: 1.4;
    text-transform: uppercase;
  }

  .logo-text span {
    display: block;
    font-size: 10px;
    color: rgba(249,244,236,0.5);
    letter-spacing: 0.08em;
  }

  .dese-badge {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: rgba(200,151,58,0.6);
    text-align: right;
    line-height: 1.6;
  }

  .hero {
    text-align: center;
    margin-bottom: 70px;
  }

  .hero-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 0.25em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .hero-eyebrow::before, .hero-eyebrow::after {
    content: '';
    height: 1px;
    width: 60px;
    background: linear-gradient(90deg, transparent, var(--gold));
  }

  .hero-eyebrow::after {
    background: linear-gradient(270deg, transparent, var(--gold));
  }

  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(42px, 6vw, 80px);
    font-weight: 900;
    line-height: 1.05;
    color: var(--cream);
    margin-bottom: 10px;
    letter-spacing: -0.02em;
  }

  .hero h1 em {
    font-style: italic;
    color: var(--gold-light);
  }

  .hero-subtitle {
    font-family: 'Cinzel', serif;
    font-size: 14px;
    letter-spacing: 0.2em;
    color: rgba(200,151,58,0.7);
    margin-bottom: 20px;
  }

  .hero-description {
    font-size: 17px;
    line-height: 1.7;
    color: rgba(249,244,236,0.65);
    max-width: 560px;
    margin: 0 auto 40px;
    font-style: italic;
    font-weight: 300;
  }

  .essential-question {
    display: inline-block;
    background: rgba(200,151,58,0.1);
    border: 1px solid rgba(200,151,58,0.3);
    border-radius: 4px;
    padding: 14px 28px;
    font-size: 15px;
    color: var(--gold-pale);
    font-style: italic;
    font-weight: 300;
  }

  /* UNIT CARDS GRID */
  .units-label {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 0.25em;
    color: rgba(200,151,58,0.6);
    text-transform: uppercase;
    text-align: center;
    margin-bottom: 32px;
    display: flex;
    align-items: center;
    gap: 16px;
    justify-content: center;
  }

  .units-label::before, .units-label::after {
    content: '';
    height: 1px;
    width: 80px;
    background: rgba(200,151,58,0.25);
  }

  .units-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-bottom: 50px;
  }

  .unit-card {
    background: rgba(26,47,70,0.7);
    border: 1px solid rgba(200,151,58,0.15);
    border-radius: 12px;
    padding: 32px 24px;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(10px);
  }

  .unit-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--gold), var(--gold-light));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .unit-card:hover {
    border-color: rgba(200,151,58,0.4);
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4), var(--shadow-gold);
    background: rgba(26,47,70,0.9);
  }

  .unit-card:hover::before { transform: scaleX(1); }

  .unit-number {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .unit-icon {
    font-size: 40px;
    margin-bottom: 14px;
    display: block;
    filter: drop-shadow(0 2px 8px rgba(200,151,58,0.3));
  }

  .unit-card h3 {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 700;
    color: var(--cream);
    margin-bottom: 10px;
    line-height: 1.2;
  }

  .unit-card p {
    font-size: 13px;
    color: rgba(249,244,236,0.5);
    line-height: 1.6;
    font-style: italic;
    margin-bottom: 20px;
  }

  .unit-clusters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }

  .cluster-tag {
    font-size: 10px;
    font-family: 'Cinzel', serif;
    letter-spacing: 0.05em;
    background: rgba(200,151,58,0.1);
    border: 1px solid rgba(200,151,58,0.2);
    color: rgba(200,151,58,0.8);
    padding: 3px 8px;
    border-radius: 2px;
  }

  .unit-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid rgba(200,151,58,0.1);
  }

  .module-count {
    font-size: 11px;
    color: rgba(249,244,236,0.4);
    font-family: 'Cinzel', serif;
    letter-spacing: 0.05em;
  }

  .explore-btn {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--gold);
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: gap 0.2s;
  }

  .unit-card:hover .explore-btn { gap: 10px; }

  /* CURRICULUM NAVIGATOR CARD */
  .nav-card {
    background: linear-gradient(135deg, rgba(200,151,58,0.12), rgba(29,78,90,0.2));
    border: 1px solid rgba(200,151,58,0.3);
    border-radius: 12px;
    padding: 32px;
    display: flex;
    align-items: center;
    gap: 24px;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-bottom: 20px;
  }

  .nav-card:hover {
    background: linear-gradient(135deg, rgba(200,151,58,0.18), rgba(29,78,90,0.3));
    border-color: rgba(200,151,58,0.5);
    transform: translateY(-2px);
    box-shadow: var(--shadow-gold);
  }

  .nav-card-icon {
    font-size: 48px;
    flex-shrink: 0;
  }

  .nav-card-text h3 {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    color: var(--cream);
    margin-bottom: 6px;
  }

  .nav-card-text p {
    font-size: 14px;
    color: rgba(249,244,236,0.55);
    font-style: italic;
    font-weight: 300;
  }

  .nav-card-arrow {
    margin-left: auto;
    font-size: 24px;
    color: var(--gold);
    transition: transform 0.2s;
    flex-shrink: 0;
  }

  .nav-card:hover .nav-card-arrow { transform: translateX(6px); }

  /* HOME FOOTER */
  .home-footer {
    text-align: center;
    padding: 30px 0;
    border-top: 1px solid rgba(200,151,58,0.1);
    font-size: 12px;
    color: rgba(249,244,236,0.25);
    font-family: 'Cinzel', serif;
    letter-spacing: 0.05em;
  }

  /* ===== UNIT SCREEN ===== */
  #unit-screen {
    background: var(--navy);
    min-height: 100vh;
  }

  .unit-header {
    background: linear-gradient(180deg, var(--navy-mid) 0%, var(--navy) 100%);
    border-bottom: 1px solid rgba(200,151,58,0.15);
    padding: 0 24px;
  }

  .unit-header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 20px 0 28px;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 0.15em;
    color: rgba(200,151,58,0.7);
    text-transform: uppercase;
    cursor: pointer;
    margin-bottom: 20px;
    transition: color 0.2s;
    background: none;
    border: none;
  }

  .back-btn:hover { color: var(--gold); }

  .unit-header-top {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .unit-header-icon {
    font-size: 56px;
    flex-shrink: 0;
    filter: drop-shadow(0 4px 12px rgba(200,151,58,0.4));
  }

  .unit-header-text .unit-label {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .unit-header-text h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 900;
    color: var(--cream);
    line-height: 1.1;
    margin-bottom: 10px;
  }

  .unit-header-text .unit-eq {
    font-size: 14px;
    color: rgba(200,151,58,0.7);
    font-style: italic;
    font-weight: 300;
  }

  /* MODULE TABS */
  .module-tabs {
    display: flex;
    gap: 0;
    background: rgba(13,27,42,0.8);
    border-bottom: 1px solid rgba(200,151,58,0.1);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0 24px;
  }

  .module-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 20px;
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(249,244,236,0.45);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
    white-space: nowrap;
    background: none;
    border-top: none;
    border-left: none;
    border-right: none;
  }

  .module-tab:hover { color: rgba(249,244,236,0.8); }

  .module-tab.active {
    color: var(--gold);
    border-bottom-color: var(--gold);
  }

  /* MODULE CONTENT */
  .module-content {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 24px 60px;
  }

  .module-panel { display: none; }
  .module-panel.active { display: block; }

  /* ===== MODULE: CLUSTERS/OVERVIEW ===== */
  .cluster-list {
    display: grid;
    gap: 20px;
  }

  .cluster-card {
    background: rgba(26,47,70,0.6);
    border: 1px solid rgba(200,151,58,0.12);
    border-radius: 10px;
    padding: 28px;
    transition: border-color 0.2s;
  }

  .cluster-card:hover { border-color: rgba(200,151,58,0.25); }

  .cluster-card h4 {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    color: var(--cream);
    margin-bottom: 10px;
  }

  .cluster-card .sq {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .cluster-card p {
    font-size: 14px;
    line-height: 1.75;
    color: rgba(249,244,236,0.6);
    font-style: italic;
    font-weight: 300;
  }

  /* ===== MODULE: QUIZ ===== */
  .quiz-container { max-width: 720px; margin: 0 auto; }

  .quiz-question-card {
    background: rgba(26,47,70,0.7);
    border: 1px solid rgba(200,151,58,0.15);
    border-radius: 12px;
    padding: 36px;
    margin-bottom: 16px;
  }

  .quiz-q-num {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .quiz-question-card h4 {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    color: var(--cream);
    line-height: 1.4;
    margin-bottom: 24px;
  }

  .quiz-options {
    display: grid;
    gap: 10px;
  }

  .quiz-option {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    background: rgba(13,27,42,0.6);
    border: 1px solid rgba(200,151,58,0.1);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 15px;
    color: rgba(249,244,236,0.8);
    text-align: left;
    width: 100%;
  }

  .quiz-option:hover:not(.answered) {
    background: rgba(200,151,58,0.08);
    border-color: rgba(200,151,58,0.3);
    color: var(--cream);
  }

  .quiz-option.correct {
    background: rgba(43,92,58,0.3);
    border-color: #4a9c6a;
    color: #7dcc9a;
  }

  .quiz-option.incorrect {
    background: rgba(139,43,43,0.3);
    border-color: #c45c5c;
    color: #e88888;
  }

  .option-letter {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(200,151,58,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cinzel', serif;
    font-size: 11px;
    color: var(--gold);
    flex-shrink: 0;
    font-weight: 600;
  }

  .quiz-feedback {
    margin-top: 16px;
    padding: 14px 18px;
    border-radius: 8px;
    font-size: 14px;
    line-height: 1.6;
    display: none;
  }

  .quiz-feedback.show { display: block; }
  .quiz-feedback.correct { background: rgba(43,92,58,0.2); border: 1px solid rgba(74,156,106,0.3); color: #7dcc9a; }
  .quiz-feedback.incorrect { background: rgba(139,43,43,0.2); border: 1px solid rgba(196,92,92,0.3); color: #e88888; }

  .quiz-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 28px;
  }

  .quiz-progress {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: rgba(249,244,236,0.4);
  }

  .quiz-score {
    text-align: center;
    padding: 48px;
    background: rgba(26,47,70,0.7);
    border: 1px solid rgba(200,151,58,0.2);
    border-radius: 12px;
  }

  .quiz-score h3 {
    font-family: 'Playfair Display', serif;
    font-size: 36px;
    color: var(--gold);
    margin-bottom: 8px;
  }

  .quiz-score p { color: rgba(249,244,236,0.6); margin-bottom: 24px; }

  /* ===== MODULE: TIMELINE ===== */
  .timeline-container { position: relative; }

  .timeline-intro {
    font-size: 15px;
    color: rgba(249,244,236,0.6);
    font-style: italic;
    margin-bottom: 32px;
    font-weight: 300;
    line-height: 1.7;
  }

  .timeline-track {
    position: relative;
    padding: 20px 0;
  }

  .timeline-line {
    position: absolute;
    left: 50%;
    top: 0; bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, transparent, var(--gold), transparent);
    transform: translateX(-50%);
  }

  .timeline-item {
    display: flex;
    align-items: flex-start;
    gap: 30px;
    margin-bottom: 40px;
    position: relative;
  }

  .timeline-item:nth-child(odd) { flex-direction: row-reverse; }
  .timeline-item:nth-child(odd) .timeline-content { text-align: right; }

  .timeline-dot {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 14px;
    height: 14px;
    background: var(--gold);
    border-radius: 50%;
    border: 2px solid var(--navy);
    box-shadow: 0 0 0 4px rgba(200,151,58,0.2);
    z-index: 2;
    flex-shrink: 0;
    top: 6px;
  }

  .timeline-content {
    flex: 1;
    background: rgba(26,47,70,0.6);
    border: 1px solid rgba(200,151,58,0.12);
    border-radius: 10px;
    padding: 20px;
    transition: border-color 0.2s;
  }

  .timeline-content:hover { border-color: rgba(200,151,58,0.3); }

  .timeline-date {
    font-family: 'Cinzel', serif;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--gold);
    margin-bottom: 6px;
  }

  .timeline-content h4 {
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    color: var(--cream);
    margin-bottom: 6px;
  }

  .timeline-content p {
    font-size: 13px;
    color: rgba(249,244,236,0.55);
    line-height: 1.65;
    font-style: italic;
    font-weight: 300;
  }

  .timeline-spacer { flex: 1; }

  /* ===== MODULE: MAP ===== */
  .map-container { position: relative; }

  .map-intro {
    font-size: 15px;
    color: rgba(249,244,236,0.6);
    font-style: italic;
    margin-bottom: 28px;
    font-weight: 300;
    line-height: 1.7;
  }

  .map-wrapper {
    position: relative;
    background: rgba(26,47,70,0.5);
    border: 1px solid rgba(200,151,58,0.15);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 24px;
  }

  .map-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .map-hotspot {
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .map-hotspot:hover { opacity: 0.8; }

  .map-hotspot circle { transition: r 0.2s, filter 0.2s; }
  .map-hotspot:hover circle { filter: drop-shadow(0 0 8px var(--gold)); }

  .map-popup {
    background: rgba(13,27,42,0.97);
    border: 1px solid rgba(200,151,58,0.35);
    border-radius: 10px;
    padding: 20px 24px;
    display: none;
    max-width: 380px;
  }

  .map-popup.show { display: block; }

  .map-popup h4 {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    color: var(--gold-light);
    margin-bottom: 8px;
  }

  .map-popup p {
    font-size: 14px;
    color: rgba(249,244,236,0.7);
    line-height: 1.65;
    font-style: italic;
    font-weight: 300;
  }

  .map-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 16px 20px;
    border-top: 1px solid rgba(200,151,58,0.1);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: rgba(249,244,236,0.5);
    cursor: pointer;
    transition: color 0.2s;
    padding: 4px 10px;
    border-radius: 4px;
    border: 1px solid transparent;
  }

  .legend-item:hover {
    color: var(--cream);
    border-color: rgba(200,151,58,0.2);
    background: rgba(200,151,58,0.05);
  }

  .legend-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ===== MODULE: VOCAB ===== */
  .vocab-container { max-width: 800px; margin: 0 auto; }

  .vocab-mode-toggle {
    display: flex;
    gap: 10px;
    margin-bottom: 28px;
    background: rgba(13,27,42,0.5);
    padding: 6px;
    border-radius: 8px;
    width: fit-content;
  }

  .vocab-mode-btn {
    padding: 8px 20px;
    border-radius: 6px;
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
    color: rgba(249,244,236,0.45);
    background: none;
  }

  .vocab-mode-btn.active {
    background: rgba(200,151,58,0.2);
    color: var(--gold);
    border: 1px solid rgba(200,151,58,0.3);
  }

  /* Flashcard */
  .flashcard-wrapper {
    perspective: 1000px;
    margin-bottom: 24px;
  }

  .flashcard {
    width: 100%;
    min-height: 220px;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.5s ease;
    cursor: pointer;
  }

  .flashcard.flipped { transform: rotateY(180deg); }

  .card-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 36px;
    text-align: center;
  }

  .card-front {
    background: linear-gradient(135deg, rgba(26,47,70,0.9), rgba(36,59,85,0.9));
    border: 1px solid rgba(200,151,58,0.2);
  }

  .card-back {
    background: linear-gradient(135deg, rgba(43,92,58,0.2), rgba(29,78,90,0.3));
    border: 1px solid rgba(200,151,58,0.25);
    transform: rotateY(180deg);
  }

  .card-hint {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: rgba(200,151,58,0.5);
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .card-word {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 700;
    color: var(--cream);
    margin-bottom: 8px;
  }

  .card-phonetic {
    font-size: 13px;
    color: rgba(200,151,58,0.6);
    font-style: italic;
    margin-bottom: 16px;
  }

  .card-definition {
    font-size: 16px;
    color: rgba(249,244,236,0.8);
    line-height: 1.6;
    font-style: italic;
    font-weight: 300;
  }

  .card-example {
    margin-top: 12px;
    font-size: 13px;
    color: rgba(249,244,236,0.5);
    font-style: italic;
    border-top: 1px solid rgba(200,151,58,0.1);
    padding-top: 12px;
  }

  .flashcard-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .fc-progress {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    color: rgba(249,244,236,0.4);
    letter-spacing: 0.1em;
  }

  /* Matching Game */
  .matching-game { display: none; }
  .matching-game.active { display: block; }

  .matching-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 24px;
  }

  .match-card {
    background: rgba(26,47,70,0.7);
    border: 1px solid rgba(200,151,58,0.15);
    border-radius: 8px;
    padding: 16px;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 14px;
    color: rgba(249,244,236,0.8);
    text-align: center;
    min-height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1.4;
  }

  .match-card:hover:not(.matched):not(.selected) {
    border-color: rgba(200,151,58,0.4);
    background: rgba(200,151,58,0.08);
  }

  .match-card.selected {
    border-color: var(--gold);
    background: rgba(200,151,58,0.15);
    color: var(--cream);
  }

  .match-card.matched {
    border-color: #4a9c6a;
    background: rgba(43,92,58,0.25);
    color: #7dcc9a;
    cursor: default;
  }

  .match-card.wrong {
    border-color: #c45c5c;
    background: rgba(139,43,43,0.25);
    animation: shake 0.3s ease;
  }

  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-6px); }
    75% { transform: translateX(6px); }
  }

  /* ===== MODULE: IMAGE ANALYSIS ===== */
  .image-analysis { max-width: 800px; margin: 0 auto; }

  .source-selector {
    display: flex;
    gap: 10px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .source-btn {
    padding: 8px 18px;
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 20px;
    cursor: pointer;
    border: 1px solid rgba(200,151,58,0.2);
    background: rgba(13,27,42,0.5);
    color: rgba(249,244,236,0.5);
    transition: all 0.2s;
  }

  .source-btn.active, .source-btn:hover {
    background: rgba(200,151,58,0.15);
    border-color: rgba(200,151,58,0.4);
    color: var(--gold);
  }

  .source-display {
    background: rgba(26,47,70,0.6);
    border: 1px solid rgba(200,151,58,0.15);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 24px;
  }

  .source-image-area {
    background: rgba(13,27,42,0.8);
    min-height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 32px;
  }

  .source-visual {
    font-size: 120px;
    filter: drop-shadow(0 8px 24px rgba(200,151,58,0.2));
    animation: float 4s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .source-caption {
    padding: 18px 24px;
    border-top: 1px solid rgba(200,151,58,0.1);
  }

  .source-caption h4 {
    font-family: 'Playfair Display', serif;
    font-size: 16px;
    color: var(--cream);
    margin-bottom: 4px;
  }

  .source-caption p {
    font-size: 12px;
    color: rgba(249,244,236,0.45);
    font-style: italic;
  }

  .stw-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 24px;
  }

  .stw-card {
    background: rgba(26,47,70,0.6);
    border: 1px solid rgba(200,151,58,0.12);
    border-radius: 10px;
    padding: 20px;
  }

  .stw-label {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 0.15em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .stw-prompt {
    font-size: 13px;
    color: rgba(249,244,236,0.55);
    font-style: italic;
    margin-bottom: 10px;
    font-weight: 300;
    line-height: 1.5;
  }

  .stw-input {
    width: 100%;
    background: rgba(13,27,42,0.5);
    border: 1px solid rgba(200,151,58,0.15);
    border-radius: 6px;
    padding: 10px 12px;
    color: var(--cream);
    font-family: 'Source Serif 4', serif;
    font-size: 13px;
    resize: vertical;
    min-height: 80px;
    transition: border-color 0.2s;
    outline: none;
  }

  .stw-input:focus { border-color: rgba(200,151,58,0.4); }

  .stw-prompts-section {
    background: rgba(13,27,42,0.5);
    border: 1px solid rgba(200,151,58,0.1);
    border-radius: 10px;
    padding: 20px;
  }

  .stw-prompts-section h4 {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 0.15em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .prompt-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .prompt-item {
    font-size: 13px;
    color: rgba(249,244,236,0.6);
    font-style: italic;
    font-weight: 300;
    padding-left: 14px;
    border-left: 2px solid rgba(200,151,58,0.2);
    line-height: 1.5;
  }

  /* ===== MODULE: DBQ ===== */
  .dbq-container { max-width: 800px; margin: 0 auto; }

  .dbq-intro {
    background: rgba(26,47,70,0.6);
    border: 1px solid rgba(200,151,58,0.15);
    border-left: 4px solid var(--gold);
    border-radius: 0 10px 10px 0;
    padding: 20px 24px;
    margin-bottom: 28px;
  }

  .dbq-intro h4 {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .dbq-intro p {
    font-size: 15px;
    color: rgba(249,244,236,0.75);
    font-style: italic;
    font-weight: 300;
    line-height: 1.65;
  }

  .dbq-document {
    background: var(--parchment);
    border: 1px solid rgba(139,110,65,0.3);
    border-radius: 8px;
    padding: 28px 32px;
    margin-bottom: 20px;
    color: var(--text-dark);
    position: relative;
  }

  .dbq-document::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid rgba(139,110,65,0.1);
    pointer-events: none;
    border-radius: 4px;
  }

  .dbq-doc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(139,110,65,0.2);
  }

  .dbq-doc-num {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--text-mid);
    text-transform: uppercase;
  }

  .dbq-doc-source {
    font-size: 11px;
    color: var(--text-mid);
    font-style: italic;
  }

  .dbq-document p {
    font-size: 14px;
    line-height: 1.8;
    color: var(--text-dark);
    font-style: italic;
  }

  .dbq-questions {
    background: rgba(26,47,70,0.6);
    border: 1px solid rgba(200,151,58,0.15);
    border-radius: 10px;
    padding: 24px;
    margin-bottom: 20px;
  }

  .dbq-questions h4 {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 0.15em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .dbq-question-item {
    margin-bottom: 20px;
  }

  .dbq-question-item label {
    display: block;
    font-size: 14px;
    color: rgba(249,244,236,0.8);
    margin-bottom: 8px;
    line-height: 1.5;
  }

  .dbq-answer {
    width: 100%;
    background: rgba(13,27,42,0.6);
    border: 1px solid rgba(200,151,58,0.15);
    border-radius: 6px;
    padding: 12px;
    color: var(--cream);
    font-family: 'Source Serif 4', serif;
    font-size: 14px;
    resize: vertical;
    min-height: 90px;
    outline: none;
    transition: border-color 0.2s;
  }

  .dbq-answer:focus { border-color: rgba(200,151,58,0.4); }

  .dbq-rubric {
    background: rgba(13,27,42,0.5);
    border: 1px solid rgba(200,151,58,0.1);
    border-radius: 10px;
    padding: 22px;
  }

  .dbq-rubric h4 {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 0.15em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .rubric-item {
    display: flex;
    gap: 12px;
    margin-bottom: 10px;
    font-size: 13px;
    color: rgba(249,244,236,0.6);
  }

  .rubric-check {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    border: 1px solid rgba(200,151,58,0.3);
    flex-shrink: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    transition: all 0.2s;
  }

  .rubric-check.checked {
    background: rgba(200,151,58,0.2);
    border-color: var(--gold);
    color: var(--gold);
  }

  /* ===== CURRICULUM NAVIGATOR ===== */
  #navigator-screen {
    background: var(--navy);
  }

  .nav-screen-header {
    background: var(--navy-mid);
    border-bottom: 1px solid rgba(200,151,58,0.15);
    padding: 20px 24px;
  }

  .nav-screen-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .nav-screen-content {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 24px 60px;
  }

  .nav-unit-section {
    margin-bottom: 48px;
  }

  .nav-unit-title {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(200,151,58,0.15);
  }

  .nav-unit-title h3 {
    font-family: 'Playfair Display', serif;
    font-size: 26px;
    color: var(--cream);
  }

  .nav-unit-title .unit-icon-sm { font-size: 32px; }

  .nav-cluster-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .nav-cluster {
    background: rgba(26,47,70,0.6);
    border: 1px solid rgba(200,151,58,0.12);
    border-radius: 10px;
    padding: 22px;
    transition: all 0.2s;
  }

  .nav-cluster:hover {
    border-color: rgba(200,151,58,0.3);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }

  .nav-cluster-label {
    font-family: 'Cinzel', serif;
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .nav-cluster h4 {
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    color: var(--cream);
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .nav-cluster .sq-text {
    font-size: 12px;
    color: rgba(200,151,58,0.7);
    font-style: italic;
    margin-bottom: 10px;
    line-height: 1.4;
  }

  .nav-cluster p {
    font-size: 12px;
    color: rgba(249,244,236,0.45);
    line-height: 1.6;
    font-style: italic;
    font-weight: 300;
  }

  .dese-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--gold);
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .dese-link:hover { opacity: 1; }

  /* ===== SHARED BUTTONS ===== */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 6px;
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
  }

  .btn-gold {
    background: linear-gradient(135deg, var(--gold), var(--gold-light));
    color: var(--navy);
    font-weight: 600;
    box-shadow: var(--shadow-gold);
  }

  .btn-gold:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(200,151,58,0.4);
  }

  .btn-outline {
    background: transparent;
    border: 1px solid rgba(200,151,58,0.35);
    color: var(--gold);
  }

  .btn-outline:hover {
    background: rgba(200,151,58,0.1);
    border-color: var(--gold);
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .site-header { flex-direction: column; gap: 12px; text-align: center; }
    .timeline-item, .timeline-item:nth-child(odd) {
      flex-direction: column;
      padding-left: 30px;
    }
    .timeline-item:nth-child(odd) .timeline-content { text-align: left; }
    .timeline-line { left: 0; }
    .timeline-dot { left: 0; }
    .timeline-spacer { display: none; }
    .stw-grid { grid-template-columns: 1fr; }
    .matching-grid { grid-template-columns: 1fr; }
    .nav-card { flex-direction: column; text-align: center; }
    .nav-card-arrow { display: none; }
    .unit-header-top { flex-direction: column; }
  }

  /* Animations */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .screen.active .home-content,
  .module-panel.active { animation: fadeIn 0.4s ease forwards; }

  /* TODAY'S LESSON BANNER */
  .today-banner {
    background: linear-gradient(135deg, rgba(200,151,58,0.15), rgba(29,78,90,0.2));
    border: 1px solid rgba(200,151,58,0.4);
    border-radius: 10px; padding: 14px 20px;
    margin-bottom: 20px; display: flex;
    align-items: center; gap: 14px;
    cursor: pointer; transition: all 0.2s;
    animation: fadeIn 0.4s ease both;
  }
  .today-banner:hover { border-color: var(--gold); }
  .today-pulse { width:9px; height:9px; background:var(--gold); border-radius:50%; flex-shrink:0; animation: pulse 2s infinite; }
  @keyframes pulse { 0%{box-shadow:0 0 0 0 rgba(200,151,58,0.6)} 70%{box-shadow:0 0 0 8px rgba(200,151,58,0)} 100%{box-shadow:0 0 0 0 rgba(200,151,58,0)} }
  .today-text { flex:1; }
  .today-label { font-family:'Cinzel',serif; font-size:9px; letter-spacing:0.2em; color:var(--gold); text-transform:uppercase; margin-bottom:2px; }
  .today-title { font-size:15px; color:var(--cream); }
  .today-arrow { color:var(--gold); font-size:16px; transition:transform 0.2s; }
  .today-banner:hover .today-arrow { transform:translateX(4px); }

  /* UNIT LANDING PAGE */
  .unit-landing-hero { background:linear-gradient(180deg,var(--navy-mid),var(--navy)); border-bottom:1px solid rgba(200,151,58,0.15); padding:32px 24px 24px; text-align:center; margin-bottom:28px; position:relative; overflow:hidden; }
  .unit-landing-hero::before { content:''; position:absolute; inset:0; background:repeating-linear-gradient(45deg,rgba(200,151,58,0.02) 0,rgba(200,151,58,0.02) 1px,transparent 0,transparent 28px); }
  .landing-icon { font-size:60px; display:block; margin-bottom:10px; filter:drop-shadow(0 4px 16px rgba(200,151,58,0.3)); position:relative; }
  .landing-unit-label { font-family:'Cinzel',serif; font-size:11px; letter-spacing:0.2em; color:var(--gold); text-transform:uppercase; margin-bottom:6px; }
  .landing-title { font-family:'Playfair Display',serif; font-size:clamp(26px,5vw,46px); font-weight:900; color:var(--cream); margin-bottom:14px; line-height:1.1; }
  .landing-eq { display:inline-block; background:rgba(200,151,58,0.1); border:1px solid rgba(200,151,58,0.3); border-radius:6px; padding:11px 22px; font-size:15px; color:var(--gold-pale); font-style:italic; font-weight:300; max-width:580px; }
  .landing-stats { display:flex; gap:20px; justify-content:center; flex-wrap:wrap; margin-top:20px; }
  .landing-stat { text-align:center; background:rgba(13,27,42,0.5); border:1px solid rgba(200,151,58,0.15); border-radius:8px; padding:11px 18px; min-width:80px; }
  .landing-stat .snum { font-family:'Playfair Display',serif; font-size:22px; font-weight:700; color:var(--gold); display:block; }
  .landing-stat .slbl { font-family:'Cinzel',serif; font-size:9px; letter-spacing:0.12em; color:rgba(249,244,236,0.4); text-transform:uppercase; }
  .landing-clusters { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:14px; margin-bottom:28px; }
  .lcc { background:rgba(26,47,70,0.6); border:1px solid rgba(200,151,58,0.12); border-radius:10px; padding:18px; transition:all 0.2s; }
  .lcc:hover { border-color:rgba(200,151,58,0.3); transform:translateY(-2px); }
  .lcc-label { font-family:'Cinzel',serif; font-size:9px; letter-spacing:0.15em; color:var(--gold); text-transform:uppercase; margin-bottom:5px; }
  .lcc-title { font-family:'Playfair Display',serif; font-size:15px; color:var(--cream); margin-bottom:5px; line-height:1.3; }
  .lcc-sq { font-size:12px; color:rgba(200,151,58,0.7); font-style:italic; margin-bottom:8px; line-height:1.4; }
