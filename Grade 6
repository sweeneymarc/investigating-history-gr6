function saveQuizResult(score, total) {
  const uk = getUnitKey();
  if (!quizScores[uk]) quizScores[uk] = [];
  const pct = Math.round(score / total * 100);
  quizScores[uk].unshift(pct);
  quizScores[uk] = quizScores[uk].slice(0, 5); // keep last 5
  saveQuizScores(quizScores);
  const best = Math.max(...quizScores[uk]);
  if (!unitActivity[uk]) unitActivity[uk] = {};
  unitActivity[uk].bestQuizScore = best;
  checkAchievements();
}

