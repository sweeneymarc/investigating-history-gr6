  { id: 'explorer', icon: '🗺️', label: 'Map Explorer', how: 'Open the map module', check: (u, data) => data.mapOpened },
  { id: 'scholar', icon: '📜', label: 'Document Scholar', how: 'Complete a DBQ', check: (u, data) => data.dbqStarted },
