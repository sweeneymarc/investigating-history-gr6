function setVocabMode(mode) {
  vocabMode = mode;
  document.querySelectorAll('.vocab-mode-btn').forEach(b => b.classList.remove('active'));
  event.target.classList.add('active');
  document.getElementById('vocab-flash').style.display = mode === 'flash' ? 'block' : 'none';
  const matchEl = document.getElementById('vocab-match');
  matchEl.style.display = mode === 'match' ? 'block' : 'none';
  matchEl.classList.toggle('active', mode === 'match');
