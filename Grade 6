// ============================================================
//  NAVIGATION
// ============================================================
function goHome() {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('home').classList.add('active');
  currentUnit = null;
}

function openUnit(idx) {
  currentUnit = UNITS[idx];
  showModule('overview');
  renderUnit();
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('unit-screen').classList.add('active');
  document.querySelector('.module-tabs').scrollLeft = 0;
}

function openNavigator() {
  renderNavigator();
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('navigator-screen').classList.add('active');
}

function showModule(mod) {
  currentModule = mod;
  document.querySelectorAll('.module-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.module-panel').forEach(p => p.classList.remove('active'));
  event && event.target && event.target.classList.add('active');
  document.querySelectorAll('.module-tab').forEach(t => {
    if (t.getAttribute('onclick') && t.getAttribute('onclick').includes(`'${mod}'`)) t.classList.add('active');
  });
  const panel = document.getElementById(`panel-${mod}`);
  if (panel) panel.classList.add('active');
  renderModule(mod);
}

// ============================================================
//  RENDER UNIT HEADER
// ============================================================
function renderUnit() {
  const u = currentUnit;
  document.getElementById('unit-icon').textContent = u.icon;
  document.getElementById('unit-label').textContent = u.label;
  document.getElementById('unit-title').textContent = u.title;
  document.getElementById('unit-eq').textContent = u.eq;
  renderModule('overview');
}

// ============================================================
//  RENDER MODULES
// ============================================================
function renderModule(mod) {
  if (!currentUnit) return;
  switch(mod) {
    case 'overview': renderOverview(); break;
    case 'timeline': renderTimeline(); break;
    case 'map': renderMap(); break;
    case 'vocab': renderVocab(); break;
    case 'image': renderImage(); break;
    case 'dbq': renderDBQ(); break;
    case 'quiz': renderQuiz(); break;
  }
}

// OVERVIEW
function renderOverview() {
  const u = currentUnit;
  const list = document.getElementById('cluster-list');
  list.innerHTML = u.clusters.map(c => `
