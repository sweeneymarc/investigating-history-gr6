function updateCard() {
  const card = currentCards[cardIndex];
  document.getElementById('card-word').textContent = card.word;
  document.getElementById('card-phonetic').textContent = card.phonetic;
  document.getElementById('card-def').textContent = card.def;
  document.getElementById('card-example').textContent = '📖 ' + card.example;
  document.getElementById('fc-progress').textContent = `${cardIndex + 1} of ${currentCards.length}`;
  const fc = document.getElementById('flashcard');
  fc.classList.remove('flipped');
  cardFlipped = false;
}

function flipCard() {
  cardFlipped = !cardFlipped;
  document.getElementById('flashcard').classList.toggle('flipped', cardFlipped);
}

function nextCard() {
  cardIndex = (cardIndex + 1) % currentCards.length;
  updateCard();
}

function prevCard() {
  cardIndex = (cardIndex - 1 + currentCards.length) % currentCards.length;
  updateCard();
}

function shuffleCards() {
  currentCards = [...currentCards].sort(() => Math.random() - 0.5);
  cardIndex = 0;
  updateCard();
}

function renderMatch() {
  const words = currentUnit.vocab.slice(0, 6);
  const wordItems = words.map((v, i) => ({ id: i, type: 'word', text: v.word, pairId: i }));
  const defItems = words.map((v, i) => ({ id: i + 6, type: 'def', text: v.def.substring(0, 70) + '...', pairId: i }));
  matchPairs = [...wordItems, ...defItems].sort(() => Math.random() - 0.5);
  selectedMatch = null;

  document.getElementById('matching-grid').innerHTML = matchPairs.map((item, i) => `
    <div class="match-card" id="match-${i}" onclick="selectMatch(${i})" data-pair="${item.pairId}" data-type="${item.type}">
      ${item.text}
    </div>
  `).join('');
  document.getElementById('match-result').style.display = 'none';
}

function selectMatch(i) {
  const card = document.getElementById(`match-${i}`);
  if (card.classList.contains('matched')) return;

  if (selectedMatch === null) {
    document.querySelectorAll('.match-card').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');
    selectedMatch = i;
  } else {
    const prev = document.getElementById(`match-${selectedMatch}`);
    const prevPair = prev.getAttribute('data-pair');
    const prevType = prev.getAttribute('data-type');
    const curPair = card.getAttribute('data-pair');
    const curType = card.getAttribute('data-type');

    if (prevPair === curPair && prevType !== curType) {
      prev.classList.remove('selected');
      prev.classList.add('matched');
      card.classList.add('matched');
      const matched = document.querySelectorAll('.match-card.matched').length;
      if (matched === matchPairs.length) {
        document.getElementById('match-result').style.display = 'block';
        document.getElementById('match-result').textContent = '🎉 Perfect! All matched!';
      }
    } else {
      prev.classList.remove('selected');
      card.classList.add('wrong');
      setTimeout(() => card.classList.remove('wrong'), 500);
    }
    selectedMatch = null;
  }
}

function resetMatch() { renderMatch(); }

