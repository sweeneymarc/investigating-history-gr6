      <div class="sq">${c.label} · Supporting Question</div>
      <h4>${c.title}</h4>
      <p style="color:var(--gold-pale);font-style:normal;margin-bottom:10px;font-size:14px;">"${c.sq}"</p>
      <p>${c.desc}</p>
    </div>
  `).join('');
}

